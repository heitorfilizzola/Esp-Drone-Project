# Configurações de Conexão com o Broker EMQX (WebSocket)
# Copie este arquivo para .env e preencha com as credenciais reais
EXPO_PUBLIC_MQTT_BROKER_URL=ws://192.168.0.22:8083/mqtt
# Atenção: O tópico MQTT com wildcard '#' deve ser envolvido entre aspas duplas: "drone/#"
EXPO_PUBLIC_MQTT_TOPIC="drone/#"
EXPO_PUBLIC_MQTT_USERNAME=esp32s3_tof90
# Atenção: Se a senha contiver caracteres especiais como #, envolva-a entre aspas duplas: "senha#"
EXPO_PUBLIC_MQTT_PASSWORD="SUA_SENHA_MQTT"
